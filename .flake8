[flake8]
# Flake8 configuration compatible with Black
max-line-length = 88
extend-ignore =
    E203,
    E501,
    W503,
    D100,
    D101,
    D102,
    D103,
    D104,
    D105,
    D107,
    D200,
    D202,
    D205,
    D400,
    D401,
    C901,
    B008,
    B902,
    F401,
    F841

# Exclude paths
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    .coverage,
    migrations,
    alembic,
    tests/fixtures,
    static,
    docs

# Complexity settings
max-complexity = 10

# Import order settings
import-order-style = google
application-import-names = app,tests

# Per-file ignores
per-file-ignores =
    # Allow imports in __init__ files
    __init__.py:F401,F403
    # Allow assertions in tests
    tests/*:S101
    # Allow magic methods without docstrings in models
    app/models/*.py:D105
    # Settings files can have complex imports
    app/config.py:E402
    app/settings.py:E402
