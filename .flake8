[flake8]
# Flake8 configuration compatible with Black
max-line-length = 88
extend-ignore =
    # Black compatibility
    E203,  # Whitespace before ':'
    E501,  # Line too long (handled by Black)
    W503,  # Line break before binary operator
    # Documentation (can be strict later)
    D100,  # Missing docstring in public module
    D101,  # Missing docstring in public class
    D102,  # Missing docstring in public method
    D103,  # Missing docstring in public function
    D104,  # Missing docstring in public package
    D105,  # Missing docstring in magic method
    D107,  # Missing docstring in __init__
    # Complexity
    C901,  # Function is too complex (can enable later)
    # Additional Bugbear warnings to ignore
    B008,  # Do not perform function calls in argument defaults
    B902  # Invalid first argument for method

# Exclude paths
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    env,
    .env,
    build,
    dist,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    htmlcov,
    .coverage,
    migrations,
    alembic,
    tests/fixtures,
    static,
    docs

# Complexity settings
max-complexity = 10

# Import order settings
import-order-style = google
application-import-names = app,tests

# Per-file ignores
per-file-ignores =
    # Allow imports in __init__ files
    __init__.py:F401,F403
    # Allow assertions in tests
    tests/*:S101
    # Allow magic methods without docstrings in models
    app/models/*.py:D105
    # Settings files can have complex imports
    app/config.py:E402
    app/settings.py:E402
